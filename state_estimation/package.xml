<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>state_estimation</name>
  <version>0.1.0</version>
  <description>Switchable state estimation for the RoboRacer MPC: race (particle filter on /odom, as raced in race 2),
    1A (robot_localization EKF + scan-triggered particle filter + latency-compensating assembler), 1B (shadow EKF).
    One setting (ESTIMATOR in launch/estimation_launch.py) picks the estimator.</description>
  <maintainer email="noreply@example.com">Jacob Bauman</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>state_estimation_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>particle_filter</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
